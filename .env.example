VITE_API_BASE_URL=/api
VITE_ENABLE_MOCK=partial
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn
SILICONFLOW_CHAT_MODEL=Qwen/Qwen3-8B
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
NOVAOPS_AGENT_PLAN_ENABLED=true
QDRANT_HOST=localhost
QDRANT_GRPC_PORT=6334
QDRANT_BASE_URL=http://localhost:6333
NOVAOPS_AGENT_TOP_K=5
NOVAOPS_AGENT_MIN_SCORE=0.55
NOVAOPS_AGENT_RETRIEVAL_VALIDATION_MIN_SCORE=0.5
NOVAOPS_AGENT_METADATA_MAX_DOCUMENTS=200

# MCP Server（对暴露只读工具给外部 Agent 宿主；留空 = 禁用）
NOVAOPS_AGENT_MCP_SERVER_TOKEN=
# MCP Client（接入远端 MCP 服务器，如 Tavily：https://mcp.tavily.com/mcp）
# 在 application.yml 的 app.agent.mcp.remote.servers 下配置 endpoint/token/enabled
