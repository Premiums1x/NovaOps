<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.novaops.backend.agent.task.mapper.AgentAuditMapper">
  <insert id="insertAudit">insert into agent_audit_log(id,task_id,user_id,source,tool_name,args_digest,result_digest,write_operation,confirmed,allowed,detail,created_at) values(#{id},#{taskId},#{userId},#{source},#{toolName},#{argsDigest},#{resultDigest},#{writeOperation},#{confirmed},#{allowed},#{detail},now())</insert>
  <select id="listAudits" resultType="com.novaops.backend.agent.task.model.AgentAuditRecord">select * from agent_audit_log where user_id=#{userId} order by created_at desc limit #{limit}</select>
</mapper>
